{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["packages/*/src", "packages/*/test", "apps/spotify-plugin/src", "apps/companion/src", "apps/youtube-music-extension/src", "apps/youtube-music-extension/test"]
}
